{
  "name": "chat-backend",
  "version": "1.0.0",
  "description": "Backend Express + app React (Next.js export estatico en frontend-next/out)",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server.js",
    "build": "npm --prefix frontend-next run build",
    "postinstall": "npm --prefix frontend-next ci",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.0",
    "jsdom": "^30.1.1",
    "mammoth": "^1.12.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "puppeteer": "^25.11.0"
  },
  "allowScripts": {
    "puppeteer@25.11.0": true
  }
}
