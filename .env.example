# ============================================================
# Variables de entorno de Fenix IA
# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el .env verdadero al repositorio (está en .gitignore).
# ============================================================

# Puerto donde escucha el servidor (Render lo inyecta solo)
PORT=3001

# Clave de la API de Groq (chat principal). Es obligatoria.
GROQ_API_KEY=tu_clave_groq

# Claves opcionales por proveedor
DEEPSEEK_API_KEY=tu_clave_deepseek
GEMINI_API_KEY=tu_clave_gemini

# Modelo de Gemini usado para el chat, la voz y, sobre todo, los
# documentos con hechos reales (grounding con google_search).
GEMINI_MODEL=gemini-3.6-flash

# Login con Google (opcional)
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# Secreto de las sesiones de Express (CÁMBIALO por algo largo y aleatorio)
SESSION_SECRET=cambia_esto_por_algo_secreto_muy_largo

# URL del frontend, usada por CORS en producción
FRONTEND_URL=https://tu-dominio.com

# Base de datos PostgreSQL (Render / Supabase / Neon)
DATABASE_URL=postgres://usuario:password@host:puerto/fenixia

# "production" solo cuando esté desplegado en Render
NODE_ENV=development

# ============================================================
# WhatsApp Cloud API (bot de WhatsApp en /webhook/whatsapp)
# Cómo obtener cada valor (ver Meta for Developers):
#
# 1. WHATSAPP_VERIFY_TOKEN:
#    NO viene de Meta. Es un string secreto que TÚ eliges (p. ej. "mi_token_2026").
#    Se lo pasas a Meta como "Verify token" al configurar el webhook, y el
#    servidor comprueba que coincidan.
#
# 2. WHATSAPP_ACCESS_TOKEN:
#    developers.facebook.com → tu app → WhatsApp → API Setup verás un token
#    temporal (24 h). Para uno permanente:
#    Meta Business Suite → Configuración → Usuarios del sistema → Nuevo
#    (rol "Admin"), genera un token con al menos los permisos:
#    whatsapp_business_messaging y whatsapp_business_management.
#
# 3. WHATSAPP_PHONE_NUMBER_ID:
#    Mismo panel: developers.facebook.com → tu app → WhatsApp → API Setup.
#    Al añadir un número de teléfono (o el número de prueba) aparece el
#    "Phone number ID" (es un número largo, distinto del teléfono).
#
# 4. WHATSAPP_APP_SECRET (OPCIONAL pero recomendado):
#    App dashboard → Settings → Basic → "App Secret". Se usa para verificar
#    la firma X-Hub-Signature-256 de los webhooks.
#
# 5. WHATSAPP_GRAPH_VERSION (OPCIONAL):
#    versión de Graph API, p. ej. v23.0. Si no se define se usa v23.0.
# ============================================================
WHATSAPP_VERIFY_TOKEN=elige_un_token_secreto_para_mi_webhook
WHATSAPP_ACCESS_TOKEN=pega_aqui_tu_token_permanente
WHATSAPP_PHONE_NUMBER_ID=pega_aqui_tu_phone_number_id
WHATSAPP_APP_SECRET=pega_aqui_el_app_secret_si_lo_quieres
# WHATSAPP_GRAPH_VERSION=v23.0