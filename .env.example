# ============================================================
# Variables de entorno de Fenix IA
# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el .env verdadero al repositorio (está en .gitignore).
# ============================================================

# Puerto donde escucha el servidor (Render lo inyecta solo)
PORT=3001

# Clave de la API de Groq (chat principal). Es obligatoria.
GROQ_API_KEY=tu_clave_groq

# Claves opcionales por proveedor
DEEPSEEK_API_KEY=tu_clave_deepseek
GEMINI_API_KEY=tu_clave_gemini

# Modelo de Gemini usado para el chat, la voz y, sobre todo, los
# documentos con hechos reales (grounding con google_search).
GEMINI_MODEL=gemini-3.6-flash

# Login con Google (opcional)
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# Secreto de las sesiones de Express (CÁMBIALO por algo largo y aleatorio)
SESSION_SECRET=cambia_esto_por_algo_secreto_muy_largo

# URL del frontend, usada por CORS en producción
FRONTEND_URL=https://tu-dominio.com

# Base de datos PostgreSQL (Render / Supabase / Neon)
DATABASE_URL=postgres://usuario:password@host:puerto/fenixia

# "production" solo cuando esté desplegado en Render
NODE_ENV=development